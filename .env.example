# ---------------------------------------------------------------------------
# Discord Automation Platform - example environment
# Copy to backend/.env and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development          # development | production
# DEMO_MODE=true serves deterministic mock Discord data so the dashboard can be
# explored without a Discord application. Every mock response is flagged in the
# API and badged in the UI. It is refused when ENVIRONMENT=production.
DEMO_MODE=true

# --- Discord application (https://discord.com/developers/applications) -------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/callback

# --- Database ----------------------------------------------------------------
# SQLite by default; swap for PostgreSQL with:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/discord_automation
DATABASE_URL=sqlite:///./discord_automation.db

# --- Security ----------------------------------------------------------------
# Signs the session cookie and derives the key used to encrypt OAuth tokens at
# rest. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_MINUTES=10080
# Set to true when serving over HTTPS (adds the Secure flag to the cookie).
COOKIE_SECURE=false
# "lax" is correct when the dashboard and API share a site (localhost:5173 and
# localhost:8000 do). Split them across domains and this must be "none", which
# browsers only accept together with COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# Shared secret for POST /api/webhooks/custom (X-Signature: sha256=<hmac>).
WEBHOOK_SECRET=change-me-too

# --- Frontend ----------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
